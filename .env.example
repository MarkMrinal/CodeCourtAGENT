# ==============================================================================
# CodeCourt Environment Configuration
# Hierarchy: Gemini (Primary) -> NVIDIA 1 -> NVIDIA 2 -> Groq (Last option)
# ==============================================================================

# 1. Primary: Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Fallback 1: NVIDIA NIM Primary Key
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.3-flash

# 3. Fallback 2: NVIDIA NIM Backup Key
NVIDIA_API_KEY_BACKUP=nvapi-your_backup_nvidia_api_key_here

# 4. Fallback 3 (Last option): Groq
GROQ_API_KEY=gsk_your_groq_api_key_here
